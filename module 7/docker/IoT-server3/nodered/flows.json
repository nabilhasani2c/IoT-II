    {
        "id": "c4c27693d9097f29",
        "type": "function",
        "z": "d9f858371b8e68d5",
        "name": "function 1",
        "func": "let temp = msg.payload.suhu;\nlet currentState = context.get('ledState') || 0;\n\n// Logika Histeresis\nif (temp > 31.5) {\n    currentState = 1; // Nyalakan LED jika suhu melebihi batas atas kritis\n} else if (temp < 30.0) {\n    currentState = 0; // Padamkan LED jika suhu mendingin di bawah batas bawah aman\n}\n\ncontext.set('ledState', currentState);\nmsg.payload = { \"led\": currentState };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
